# ===== CipherWS .gitignore =====
# 仓库结构（前后端同仓）：
#   frontend/  前端工作区：main/（主站）+ train/（云间列车）两个独立的 Vue3 + Vite
#              工程，roots 互不相关，各自的依赖与产物由各自的 package.json 还原；
#              根目录只放编排用 package.json、server.js 与 nginx 配置
#   server/    Spring Boot + Maven（Maven 根目录就在 server/ 这一层），
#              依赖与产物由 pom.xml 还原
#   deploy/    部署脚本/配置
#   docs/      文档
# 判断原则：能由 package.json / pom.xml 重新生成的产物一律不入库。

# ---------- 通用 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# 临时 / 缓存
.cache/
.temp/
.tmp/
*.tmp

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*~

# ---------- 前端：frontend/ ----------
# 依赖目录：体积最大，一律不入库，用 npm install 还原
node_modules/

# 构建产物：npm run build（vite build）生成，可随时重建
# 【注意】若部署流程需要仓库里带前端产物，请注释掉下两行
dist/
dist-ssr/

# Vite 缓存
.vite/
*.tsbuildinfo

# 云间列车的着色器参考素材（blue_noise.png 约 4 MB + 一份来源说明）：
#   只是开发时对着调的参考资料，着色器本身不加载它（源码里没有任何 _ref 引用），
#   构建产物也用不到，因此不入库。要保留就删掉这一行。
frontend/train/_ref/

# 包管理器锁文件与状态：
#   项目实际使用 npm，各子项目的 package-lock.json 已入库并保留
#   （frontend/main/package-lock.json、frontend/train/package-lock.json）。
#   下面两个 pnpm 文件是误用 pnpm 时生成的，不参与构建，故排除。
#   用 **/ 而不是写死路径，这样将来加第三个子项目也不用改这里。
#   若日后统一改用 pnpm，请改为忽略 package-lock.json 并保留 pnpm-lock.yaml。
**/pnpm-lock.yaml
**/pnpm-workspace.yaml

# ---------- 后端：server/（Spring Boot + Maven）----------
# Maven 编译产物（server/target/）
target/
!.mvn/wrapper/maven-wrapper.jar

# 音频资源：整个目录不入库（原 14 个文件共约 131 MB）
#   原因：体积过大，会让仓库和 clone 永久变重（GitHub 单文件上限 100 MB，
#         一旦有文件超标就再也推不上去，且事后删除也不会让历史变小）。
#   现状：音频统一放在仓库外的 deploy/music/，由 run-services.ps1 通过
#         AUDIO_MUSIC_PATH 环境变量注入；配置项是 resource.path.audio.music。
#   说明：本目录（代码区）不再放任何文件，包括说明文档；
#         相关文档见 docs/2026-10-5/音频资源说明.md。
server/cipherws-say-service/src/main/resources/music/

# 日志
logs/
*.log.gz
*.log.*

# ---------- 证书与密钥 ----------
*.pem
*.key
*.p12
*.jks

# ---------- 环境变量 ----------
# 本地/部署专用的环境变量文件一律不入库：其中包含真实后端地址（公网 IP / 内网穿透域名）。
# 注意：只写 .env 是不够的 —— 它只能匹配名为「.env」的文件，
#       匹配不到 .env.development / .env.production，必须写成 .env*。
# 模板保留入库：frontend/main/.env.example（不含真实地址，新人照抄即可）。
#   注意「!.env.example」里没有斜杠，所以在任意层级都生效 ——
#   frontend/main/.env.example 与将来 frontend/train/.env.example 都会入库。
# 如果之前已经跟踪过这些文件，需额外执行一次：
#   git rm --cached frontend/main/.env.development frontend/main/.env.production
.env*
!.env.example

# ---------- 部署：deploy/ ----------
# 结构约定：deploy/ 下「可再生的大体积资产」一律不入库；
# 只入库 5 个脚本（fetch-nacos / start-nacos / stop-nacos / run-services / update-frontend）
# 与 nginx 配置（nginx/cipherws.conf），换机器跑一次脚本即可重建。
# 相关说明文档统一放在 docs/<日期>/ 下，不在代码区放 README
# （约定见 docs/2026-10-5/本地部署说明.md）。

# 项目本地工具链（JDK 17 等，约 300 MB），由 deploy/.tools/fetch-jdk17.ps1 重建
deploy/.tools/

# Nacos 3.3.0-RC 发行包解压目录（约 235 MB），由 deploy/fetch-nacos.ps1 重建。
# 注意：仅忽略解压目录与下载的 zip；若日后要提交自定义配置，
# 请改为忽略 deploy/nacos/ 内的具体子目录（data/、logs/、work/ 等）。
deploy/nacos/

# Nacos 发行包 zip（约 219 MB），下载后即可删除，fetch 脚本会自动重下
deploy/*.zip

# 音频资源实际存放目录（约 131 MB）：从 server/.../resources/music 移出仓库，
# 由 run-services.ps1 通过 AUDIO_MUSIC_PATH 注入。
# 详见 docs/2026-10-5/音频资源说明.md
deploy/music/

# 后端服务运行日志（redeploy/run-services.ps1 生成）
deploy/.logs/

# 本机环境快照 / 回滚文件（含本机绝对路径，不入库）
deploy/*backup*.txt

# Docker 镜像 tar 体积巨大（Nacos 镜像约 588 MB），不入库；用 docker load 从本地/外部介质还原。
# 需要长期分发时改用 Docker Registry 或对象存储，不要提交进 Git（GitHub 单文件上限 100 MB）。
docker/*.tar
deploy/**/*.tar
