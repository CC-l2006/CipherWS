# ===== CipherWS .gitignore =====
# 仓库结构（前后端同仓）：
#   frontend/  Vue3 + Vite，依赖与产物由 package.json 还原
#   server/    Spring Boot + Maven（Maven 根目录就在 server/ 这一层），
#              依赖与产物由 pom.xml 还原
#   deploy/    部署脚本/配置
#   docs/      文档
# 判断原则：能由 package.json / pom.xml 重新生成的产物一律不入库。

# ---------- 通用 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# 临时 / 缓存
.cache/
.temp/
.tmp/
*.tmp

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*~

# ---------- 前端：frontend/ ----------
# 依赖目录：体积最大，一律不入库，用 npm install 还原
node_modules/

# 构建产物：npm run build（vite build）生成，可随时重建
# 【注意】若部署流程需要仓库里带前端产物，请注释掉下两行
dist/
dist-ssr/

# Vite 缓存
.vite/
*.tsbuildinfo

# 包管理器锁文件与状态：
#   项目实际使用 npm，frontend/package-lock.json 已入库并保留。
#   下面两个 pnpm 文件是误用 pnpm 时生成的，不参与构建，故排除。
#   若日后统一改用 pnpm，请改为忽略 package-lock.json 并保留 pnpm-lock.yaml。
frontend/pnpm-lock.yaml
frontend/pnpm-workspace.yaml

# ---------- 后端：server/（Spring Boot + Maven）----------
# Maven 编译产物（server/target/）
target/
!.mvn/wrapper/maven-wrapper.jar

# 音频资源：不入库（14 个文件共约 131 MB）
#   原因：体积过大，会让仓库和 clone 永久变重（GitHub 单文件上限 100 MB，
#         一旦有文件超标就再也推不上去，且删掉也不会让历史变小）。
#   音频改为放在仓库外（移动硬盘 / 网盘 / 对象存储），部署时放到磁盘目录，
#   由 AUDIO_MUSIC_PATH 环境变量指向（见 deploy/README.md）。
#   注意：本目录下只保留 README.md 作为说明，音频文件本体一律忽略。
#   用 /* 而不是 / 是为了让该目录下的 README.md 能被 git 跟踪
#   （若某天产生子目录且也要入库，需把 / 换成 /**）。
server/cipherws-say-service/src/main/resources/music/*
!server/cipherws-say-service/src/main/resources/music/README.md

# 日志
logs/
*.log.gz
*.log.*

# ---------- 证书与密钥 ----------
*.pem
*.key
*.p12
*.jks

# ---------- 环境变量 ----------
# 现状：frontend/.env.development 与 .env.production 只包含
# VITE_API_BASE_URL（本地/内网地址），前端运行需要，因此保持入库。
# 若日后填入真实密钥或生产域名，请改为忽略 .env* 并保留 .env.example。
.env
.env.*.local

# ---------- 部署：deploy/ ----------
# 结构约定：deploy/ 下「可再生的大体积资产」一律不入库，
# 只入库脚本与文档（fetch-nacos.ps1 / start-nacos.ps1 / stop-nacos.ps1 /
# run-services.ps1 / README.md），换机器跑一次脚本即可重建。

# 项目本地工具链（JDK 17 等，约 300 MB），由 deploy/.tools/fetch-jdk17.ps1 重建
deploy/.tools/

# Nacos 3.3.0-RC 发行包解压目录（约 235 MB），由 deploy/fetch-nacos.ps1 重建。
# 注意：仅忽略解压目录与下载的 zip；若日后要提交自定义配置，
# 请改为忽略 deploy/nacos/ 内的具体子目录（data/、logs/、work/ 等）。
deploy/nacos/

# Nacos 发行包 zip（约 219 MB），下载后即可删除，fetch 脚本会自动重下
deploy/*.zip

# 音频资源实际存放目录（约 131 MB）：从 server/.../resources/music 移出仓库，
# 由 run-services.ps1 通过 AUDIO_MUSIC_PATH 注入。详见 deploy/README.md
deploy/music/

# 后端服务运行日志（redeploy/run-services.ps1 生成）
deploy/.logs/

# 本机环境快照 / 回滚文件（含本机绝对路径，不入库）
deploy/*backup*.txt

# Docker 镜像 tar 体积巨大（Nacos 镜像约 588 MB），不入库；用 docker load 从本地/外部介质还原。
# 需要长期分发时改用 Docker Registry 或对象存储，不要提交进 Git（GitHub 单文件上限 100 MB）。
docker/*.tar
deploy/**/*.tar
