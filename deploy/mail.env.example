# =============================================================================
# 邮件（SMTP）配置模板
#
# ⚠️⚠️ 这个文件是【模板】，运行时**不会**被加载！改它不会有任何效果。
#      真正生效的是同目录下的 deploy/mail.env.local（去掉 .example 的那个）。
#      启动脚本只会读 mail.env.local —— 曾经因为改了这个文件导致
#      「换了授权码还是 535」，排查了很久。
#
# 用法：
#   1. 复制成 mail.env.local（这个后缀已被 .gitignore 的 *.local 规则忽略，
#      不会误提交）；
#   2. 填上你自己的值；
#   3. 启动 note-user-service 前先把它导出成环境变量。
#
# 为什么是「环境变量」而不是直接写进 application.yml：
#   application.yml 是被 git 跟踪的，授权码写进去等于把它推到 GitHub。
#   这个项目里所有敏感项（DB_PASSWORD、NACOS_PASSWORD、NOTE_JWT_SECRET）
#   都走环境变量，邮件也保持一致。
#
# 注意：SPRING_MAIL_* 这个前缀是 Spring Boot 的「松散绑定」约定，
# 它会自动映射成 spring.mail.*，所以不需要改任何 yml。
# =============================================================================

# SMTP 服务器地址
#   QQ 邮箱     smtp.qq.com
#   163 邮箱    smtp.163.com
#   Gmail       smtp.gmail.com
SPRING_MAIL_HOST=smtp.qq.com

# 端口：465 走隐式 SSL（默认，不用改别的）；587 走 STARTTLS（见文件末尾说明）
SPRING_MAIL_PORT=465

# 发件邮箱（通常是完整邮箱地址）
SPRING_MAIL_USERNAME=your-account@qq.com

# ⚠️ 这里填的是「授权码 / 应用专用密码」，不是邮箱登录密码
SPRING_MAIL_PASSWORD=replace-with-your-auth-code

# 发件人显示地址；留空则用 SPRING_MAIL_USERNAME
MAIL_FROM=your-account@qq.com

# 总开关：为 true 且上面 host/username 都非空时才真的发信
NOTE_MAIL_ENABLED=true

# -----------------------------------------------------------------------------
# 用 587 端口（STARTTLS）时，还需要把 note-user-service 的 application.yml 里
# spring.mail.properties.mail.smtp.ssl.enable 改成 false，并加一行
#   starttls.enable: true
# 465 就不需要动。
# -----------------------------------------------------------------------------
