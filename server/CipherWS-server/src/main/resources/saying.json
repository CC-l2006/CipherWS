[
  {"id": 1, "saying": "青年时种下什么，老年时就收获什么。", "person": "易卜生"},
  {"id": 2, "saying": "路漫漫其修远兮，吾将上下而求索。", "person": "屈原"},
  {"id": 3, "saying": "与有肝胆人共事，从无字句处读书。", "person": "周恩来"},
  {"id": 4, "saying": "出淤泥而不染，濯清涟而不妖。", "person": "周敦颐"},
  {"id": 5, "saying": "生活的理想，就是为了理想的生活。", "person": "张闻天"},
  {"id": 6, "saying": "走自己的路，让别人说去！", "person": "但丁"},
  {"id": 7, "saying": "海纳百川有容乃大，壁立千仞无欲则刚。", "person": "林则徐"},
  {"id": 8, "saying": "书是人类进步的阶梯。", "person": "高尔基"},
  {"id": 9, "saying": "要成就大事，必须从小事做起。", "person": "列宁"},
  {"id": 10, "saying": "欲穷千里目，更上一层楼。", "person": "王之涣"},
  {"id": 11, "saying": "世上无难事，只要肯登攀。", "person": "毛泽东"},
  {"id": 12, "saying": "横眉冷对千夫指，俯首甘为孺子牛。", "person": "鲁迅"},
  {"id": 13, "saying": "君子爱财，取之有道。", "person": "孔子"},
  {"id": 14, "saying": "虚心使人进步，骄傲使人落后。", "person": "毛泽东"},
  {"id": 15, "saying": "苟利国家生死以，岂因祸福避趋之。", "person": "林则徐"},
  {"id": 16, "saying": "两情若是久长时，又岂在朝朝暮暮。", "person": "秦观"},
  {"id": 17, "saying": "不想当将军的士兵，不是好士兵。", "person": "拿破仑"},
  {"id": 18, "saying": "生命诚可贵，爱情价更高。", "person": "裴多菲"},
  {"id": 19, "saying": "先天下之忧而忧，后天下之乐而乐。", "person": "范仲淹"},
  {"id": 20, "saying": "仰不愧天，俯不愧人，内不愧心。", "person": "韩愈"},
  {"id": 21, "saying": "天下兴亡，匹夫有责。", "person": "顾炎武"},
  {"id": 22, "saying": "人生自古谁无死，留取丹心照汗青。", "person": "文天祥"},
  {"id": 23, "saying": "知识就是力量。", "person": "培根"},
  {"id": 24, "saying": "如果错过太阳时流了泪，你也会错过群星。", "person": "泰戈尔"},
  {"id": 25, "saying": "古之立大事者，必有坚韧不拔之志。", "person": "苏轼"},
  {"id": 26, "saying": "立志是事业的大门，工作是登堂入室的旅程。", "person": "巴斯德"},
  {"id": 27, "saying": "盛年不重来，一日难再晨。", "person": "陶渊明"},
  {"id": 28, "saying": "三军可夺帅也，匹夫不可夺志也。", "person": "孔子"},
  {"id": 29, "saying": "吾爱吾师，吾更爱真理。", "person": "亚里士多德"},
  {"id": 30, "saying": "为中华之崛起而读书。", "person": "周恩来"},
  {"id": 31, "saying": "天行健，君子以自强不息。", "person": "《周易》"},
  {"id": 32, "saying": "地势坤，君子以厚德载物。", "person": "《周易》"},
  {"id": 33, "saying": "要散布阳光到别人心里，先得自己心里有阳光。", "person": "罗曼·罗兰"},
  {"id": 34, "saying": "少壮不努力，老大徒伤悲。", "person": "乐府"},
  {"id": 35, "saying": "己所不欲，勿施于人。", "person": "孔子"},
  {"id": 36, "saying": "美到处都有，缺的是发现美的眼睛。", "person": "罗丹"},
  {"id": 37, "saying": "你若要喜爱自己，就给世界创造价值。", "person": "歌德"},
  {"id": 38, "saying": "时间像海绵里的水，挤一挤总会有的。", "person": "鲁迅"},
  {"id": 39, "saying": "老吾老以及人之老，幼吾幼以及人之幼。", "person": "孟子"},
  {"id": 40, "saying": "富贵不能淫，贫贱不能移，威武不能屈。", "person": "孟子"},
  {"id": 41, "saying": "业精于勤，荒于嬉；行成于思，毁于随。", "person": "韩愈"},
  {"id": 42, "saying": "三人行，必有我师焉。", "person": "孔子"},
  {"id": 43, "saying": "人的生命有限，为人民服务无限。", "person": "雷锋"},
  {"id": 44, "saying": "生活不像想的那么好，也不像想的那么糟。", "person": "莫泊桑"},
  {"id": 45, "saying": "我要扼住命运的咽喉，绝不屈服！", "person": "贝多芬"},
  {"id": 46, "saying": "人的差异在于业余时间。", "person": "爱因斯坦"},
  {"id": 47, "saying": "比天空更宽阔的是人的胸怀。", "person": "雨果"},
  {"id": 48, "saying": "读一本好书，就是和高尚的人谈话。", "person": "歌德"},
  {"id": 49, "saying": "天才是百分之一的灵感加百分之九十九的汗水。", "person": "爱迪生"},
  {"id": 50, "saying": "千里之行，始于足下。", "person": "老子"},
  {"id": 51, "saying": "人不是因为美丽才可爱，而是因为可爱才美丽。", "person": "托尔斯泰"},
  {"id": 52, "saying": "给我一个支点，我能撬起地球。", "person": "阿基米德"},
  {"id": 53, "saying": "历览前贤国与家，成由勤俭败由奢。", "person": "李商隐"},
  {"id": 54, "saying": "勿以恶小而为之，勿以善小而不为。", "person": "刘备"},
  {"id": 55, "saying": "不积跬步，无以至千里。", "person": "荀子"},
  {"id": 56, "saying": "不积小流，无以成江海。", "person": "荀子"},
  {"id": 57, "saying": "天生我材必有用。", "person": "李白"},
  {"id": 58, "saying": "良好的开端是成功的一半。", "person": "亚里士多德"},
  {"id": 59, "saying": "纸上得来终觉浅，绝知此事要躬行。", "person": "陆游"},
  {"id": 60, "saying": "人可以被消灭，但不能被打败。", "person": "海明威"},
  {"id": 61, "saying": "机遇偏爱有准备的头脑。", "person": "巴斯德"},
  {"id": 62, "saying": "我愿意燃烧起来，不愿腐朽。", "person": "奥斯特洛夫斯基"},
  {"id": 63, "saying": "鞠躬尽瘁，死而后已。", "person": "诸葛亮"},
  {"id": 64, "saying": "长风破浪会有时，直挂云帆济沧海。", "person": "李白"},
  {"id": 65, "saying": "锲而不舍，金石可镂。", "person": "荀子"},
  {"id": 66, "saying": "人无远虑，必有近忧。", "person": "孔子"},
  {"id": 67, "saying": "人不可有傲气，但不可无傲骨。", "person": "徐悲鸿"},
  {"id": 68, "saying": "失败乃成功之母。", "person": "牛顿"},
  {"id": 69, "saying": "物竞天择，适者生存。", "person": "赫胥黎"},
  {"id": 70, "saying": "穷则独善其身，达则兼济天下。", "person": "孟子"},
  {"id": 71, "saying": "岂能尽如人意，但求无愧我心。", "person": "林则徐"},
  {"id": 72, "saying": "不要问国家能为你做什么，要问你能为国家做什么。", "person": "林肯"},
  {"id": 73, "saying": "有很多良友，胜于有很多财富。", "person": "莎士比亚"},
  {"id": 74, "saying": "由俭入奢易，由奢入俭难。", "person": "司马光"},
  {"id": 75, "saying": "我看得远，是因为站在巨人肩上。", "person": "牛顿"},
  {"id": 76, "saying": "吾生也有涯，而知也无涯。", "person": "庄子"},
  {"id": 77, "saying": "对任何困难都绝不屈服。", "person": "居里夫人"},
  {"id": 78, "saying": "生于忧患，死于安乐。", "person": "孟子"},
  {"id": 79, "saying": "人生的价值在于深度，而非时间。", "person": "托尔斯泰"},
  {"id": 80, "saying": "夫仁者，己欲立而立人，己欲达而达人。", "person": "孔子"},
  {"id": 81, "saying": "希望是生命的源泉，失去它生命会枯竭。", "person": "富兰克林"},
  {"id": 82, "saying": "书山有路勤为径，学海无涯苦作舟。", "person": "韩愈"},
  {"id": 83, "saying": "目标越高，才力发展越快，对社会越有益。", "person": "高尔基"},
  {"id": 84, "saying": "勤劳一生，可得幸福的长眠。", "person": "达·芬奇"},
  {"id": 85, "saying": "最快乐的事，莫过于为理想而奋斗。", "person": "苏格拉底"},
  {"id": 86, "saying": "每一个不曾起舞的日子，都是对生命的辜负。", "person": "尼采"},
  {"id": 87, "saying": "认清生活真相之后，依然热爱生活。", "person": "罗曼·罗兰"},
  {"id": 88, "saying": "人生价值在于觉醒和思考，而非生存。", "person": "亚里士多德"},
  {"id": 89, "saying": "志不强者智不达。", "person": "墨翟"},
  {"id": 90, "saying": "言不信者，行不果。", "person": "墨翟"},
  {"id": 91, "saying": "静以修身，俭以养德。", "person": "诸葛亮"},
  {"id": 92, "saying": "非淡泊无以明志，非宁静无以致远。", "person": "诸葛亮"},
  {"id": 93, "saying": "学而不思则罔，思而不学则殆。", "person": "孔子"},
  {"id": 94, "saying": "温故而知新，可以为师矣。", "person": "孔子"},
  {"id": 95, "saying": "岁寒，然后知松柏之后凋也。", "person": "孔子"},
  {"id": 96, "saying": "君子和而不同，小人同而不和。", "person": "孔子"},
  {"id": 97, "saying": "士不可以不弘毅，任重而道远。", "person": "孔子"},
  {"id": 98, "saying": "工欲善其事，必先利其器。", "person": "孔子"},
  {"id": 99, "saying": "道不同，不相为谋。", "person": "孔子"},
  {"id": 100, "saying": "知者不惑，仁者不忧，勇者不惧。", "person": "孔子"}
]