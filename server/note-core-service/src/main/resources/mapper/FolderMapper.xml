<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  文件夹表映射。

  文件夹不再绑定标签：note.folder_id 直接表示这篇笔记放在哪个文件夹。
  「自动整理」按「文件夹名 = 标签名」把未分类笔记归入（见 autoOrganize）。

  resultType="map" 的地方 key 是原始列名（下划线）。
-->
<mapper namespace="org.example.cipherws.note.core.mapper.FolderMapper">

    <select id="selectFolders" resultType="map">
        SELECT `id`, `name`, `created_at`
        FROM `note_folder`
        WHERE `user_id` = #{userId}
        ORDER BY `created_at` ASC, `id` ASC
    </select>

    <!--
      每个文件夹的笔记数：直接数 note.folder_id，不再经过标签。
      n.user_id 与 n.deleted 都卡住，回收站里的不计。
    -->
    <select id="countNotesByFolder" resultType="map">
        SELECT f.`id`                AS `folder_id`,
               COUNT(n.`id`)         AS `note_count`
        FROM `note_folder` f
                 LEFT JOIN `note` n ON n.`folder_id` = f.`id`
                     AND n.`user_id` = f.`user_id`
                     AND n.`deleted` = 0
        WHERE f.`user_id` = #{userId}
        GROUP BY f.`id`
    </select>

    <select id="countOwnedFolder" resultType="long">
        SELECT COUNT(*) FROM `note_folder` WHERE `id` = #{folderId} AND `user_id` = #{userId}
    </select>

    <insert id="insertFolder" parameterType="NoteFolder" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `note_folder` (`user_id`, `name`) VALUES (#{userId}, #{name})
    </insert>

    <update id="updateFolderName">
        UPDATE `note_folder` SET `name` = #{name} WHERE `id` = #{folderId} AND `user_id` = #{userId}
    </update>

    <!-- 删文件夹前先把笔记退回未分类，笔记本身不删 -->
    <update id="clearFolderNotes">
        UPDATE `note` SET `folder_id` = NULL
        WHERE `folder_id` = #{folderId} AND `user_id` = #{userId}
    </update>

    <delete id="deleteFolder">
        DELETE FROM `note_folder` WHERE `id` = #{folderId} AND `user_id` = #{userId}
    </delete>

    <!--
      自动整理：只动未分类（folder_id IS NULL）的笔记。
      标签名与文件夹名在 utf8mb4_0900_ai_ci 下不区分大小写，
      所以标签 "java" 会自动进文件夹 "Java"。
      一篇笔记命中多个文件夹时取 id 最小的那个，保证结果稳定。
    -->
    <update id="autoOrganize">
        UPDATE `note` n
            JOIN (SELECT n2.`id`      AS `note_id`,
                         MIN(f.`id`)  AS `folder_id`
                  FROM `note` n2
                           JOIN `note_tag_rel` r ON r.`note_id` = n2.`id`
                           JOIN `note_tag` t ON t.`id` = r.`tag_id` AND t.`user_id` = n2.`user_id`
                           JOIN `note_folder` f ON f.`user_id` = n2.`user_id` AND f.`name` = t.`name`
                  WHERE n2.`user_id` = #{userId}
                    AND n2.`deleted` = 0
                    AND n2.`folder_id` IS NULL
                  GROUP BY n2.`id`) m ON m.`note_id` = n.`id`
        SET n.`folder_id`  = m.`folder_id`,
            n.`updated_at` = CURRENT_TIMESTAMP
    </update>

</mapper>
