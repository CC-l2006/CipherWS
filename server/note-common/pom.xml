<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>cipherws</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>note-common</artifactId>
    <name>note-common</name>
    <description>笔记系统公共模块：统一响应 Result、业务异常、JWT、登录上下文</description>

    <dependencies>
        <!-- 只要 spring-web 的注解（@RestController 等由各服务自己的 starter 提供），
             不引入 starter-web，避免污染 WebFlux 网关 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- GlobalExceptionHandler 需要日志门面 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- 只需要 DataAccessException 这一个类型（它在 spring-tx 里），
             不引 spring-jdbc，避免公共模块被绑上数据库实现 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
