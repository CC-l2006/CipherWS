<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>cipherws</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cipherws-common</artifactId>
    <name>cipherws-common</name>
    <description>公共模块：统一响应 Result、领域实体、OpenFeign 服务契约</description>

    <dependencies>
        <!-- 不引入 spring-boot-starter-web，避免污染 WebFlux 网关；只依赖 spring-web 的注解 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- OpenFeign 契约接口所需的注解（各服务自行引入 starter 后即可复用该契约） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
